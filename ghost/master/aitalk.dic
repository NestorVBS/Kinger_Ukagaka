//**** OnSurfaceRestore


OnSurfaceRestore
 {
 	if takagiwatch == 0{
 		"\0\s[0]\e"
 	}elseif takagiwatch == 1{
 		"\0\s[12]\e"
 	}elseif takagiwatch ==2{
 		"\0\s[4]\e"
 	}
 }

 
 //--OnKeyPress
 //This defines the hotkeys your ghost will use.
 
OnKeyPress
{
	if reference0 == "t"
	{
	OnAiTalk
	}
	elseif reference0 == "r"
	{
	OnLastTalk
	}
	elseif reference0 == "f1"
	{
	"\![open,readme]"
	}
	//elseif reference0 == "g"
	//{
	//	"Rondas: %(glicoRounds)\nPiedra: %(timesRock)\nPapel: %(timesPaper)"
	//}
	//elseif reference0 == "p"
	//{
	//	"\![raise,OnFirstBoot,]"
	//}
}