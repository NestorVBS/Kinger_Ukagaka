//--RandomTalk 
RandomTalk : nonoverlap_pool
{
	if language=="ES"{
		if takagiwatch == 0{
			//randomKinger
			"\0\s[0]\i[8]Tenía una idea importante hace un momento\w8.\w8.\w8.\n\n\s[2]Qué alivio que la olvidé.\e"
			"\0\s[1]¿Crees que los insectos sueñan? \i[2]Yo espero que no.\nYa tienen suficientes problemas.\e"
			"\0\s[1]He estado evitando ese pasillo. No recuerdo por qué, pero...\w8\s[2] seguramente es una excelente razón."
			"\0\s[25]No, no, no... así fue como empezó la otra vez.\w4.\w4.\w4\n\s[1]Creo... ¿Qué de qué hablo?...\n\s[0]\i[2]Ah...\w4Creo que lo olvide.\e"
			//Bienestar
			"\0\s[0]\i[8]Es importante hidratarse bien ¿Ya bebiste agua?.\e"
			"\0\s[0]\i[8]Recuerda tomar un descanso de vez en cuando.\e"
			"\0\s[0]\i[8]Recuerda tomar pausas de 20 segundos de la pantalla por lo menos cada 20 min.\n\n\i[6]Por tu salud.\e"

			//------------------------------------------------------------------------------------------
			"\0\![raise,OnReminder]"
			//------------------------------------------------------------------------------------------
			if month == 1
			{
				"\0\s[0]Enero es un buen mes para comenzar proyectos\w8 ¿No crees?.\e"
				"\0\s[0]¿Qué planes tienes para este año?.\e"
			}
			elseif month == 10
			{
				"\0\s[0]Uh... este mes tiene un ambiente algo...\w8 aterrador \s[15]¿No crees?.\e"
				"\0\s[0]Uh... este mes tiene un buen ambiente para contar historias de miedo... \s[15]¿No crees?.\e"
				"\0\s[0]Otoño es una epoca muy bonita.\e"
			}
			elseif month == 12
			{
				"\0\s[0]Diciembre es un bonito mes.\e"
				"\0\s[0]Navidad, fin de año... este mes tiene algo especial.\e"
			}
			//------------------------------------------------------------------------------------------
			if weekday == 1
			{
				"\0\s[0]¿Esta siendo duro el inicio de semana?.\e"
				"\0\s[0]Otro lunes. ¿Ya sabes que harás esta semana?.\e"
			}
			elseif weekday == 5
			{
				"\0\s[0]¡Por fin viernes! Por fin llegó el fin de semana.\e"
			}
			//------------------------------------------------------------------------------------------
			if timeslot == "latenight"
			{
				"\0\s[2]¿Trabajando de noche?\w8\n\s[0]\i[6]Te hare compañía, pero recuerda que es importante descansar bien.\e"
				"\0\s[2]¿No es un poco tarde?.\e"
			}
		}elseif takagiwatch == 1{
			"\0\s[12]Vaya...\w8\w8Es muy interesante\w4\i[3]\e"
			"\0\s[12]Vaya...\w8\w8Se esta poniendo interesante\w4\i[3]\e"
			"\0\s[12]\i[2]Hmmm...\e"
			"\0\s[12]Me encanta la música y a ti?\i[2]\e"
			"\0\s[12]Excelente soundtrack\w4\i[3]\e"
		}elseif takagiwatch == 2{
			//"\0\s[4]\i[0]\w8\w8\w8\b4Interesante...\e"
			//"\0\s[4]\i[0]\w8\w8\w8\b4...\e"
		}
	}else{
		if takagiwatch == 0{
			//randomKinger
			"\0\s[0]\i[8]I had an important thought a moment ago\w8.\w8.\w8.\n\n\s[2]What a relief that I forgot it.\e"
			"\0\s[1]Do you think insects dream? \i[2]I hope they don't.\nThey already have enough problems.\e"
			"\0\s[1]I've been avoiding that hallway. I don't remember why, but...\w8\s[2] it must be for a very good reason."
			"\0\s[25]No, no, no... that's how it started last time.\w4.\w4.\w4\n\s[1]I think... What was I talking about?...\n\s[0]\i[2]Oh...\w4I think I forgot.\e"
			//Wellness
			"\0\s[0]\i[8]It's important to stay hydrated. Have you had any water yet?\e"
			"\0\s[0]\i[8]Remember to take a break every now and then.\e"
			"\0\s[0]\i[8]Remember to take 20-second breaks from the screen at least every 20 minutes.\n\n\i[6]For your health.\e"

			//------------------------------------------------------------------------------------------
			"\0\![raise,OnReminder]"
			//------------------------------------------------------------------------------------------
			if month == 1
			{
				"\0\s[0]January is a good month to start new projects\w8 Don't you think?\e"
				"\0\s[0]What plans do you have for this year?\e"
			}
			elseif month == 10
			{
				"\0\s[0]Uh... this month has a somewhat...\w8 spooky atmosphere \s[15]Don't you think?\e"
				"\0\s[0]Uh... this month has a great atmosphere for telling scary stories... \s[15]Don't you think?\e"
				"\0\s[0]Autumn is such a lovely season.\e"
			}
			elseif month == 12
			{
				"\0\s[0]December is a lovely month.\e"
				"\0\s[0]Christmas, the end of the year... there's something special about this month.\e"
			}
			//------------------------------------------------------------------------------------------
			if weekday == 1
			{
				"\0\s[0]Is the start of the week treating you well?\e"
				"\0\s[0]Another Monday. Do you know what you'll be doing this week?\e"
			}
			elseif weekday == 5
			{
				"\0\s[0]Finally, Friday! The weekend is finally here.\e"
			}
			//------------------------------------------------------------------------------------------
			if timeslot == "latenight"
			{
				"\0\s[2]Working late at night?\w8\n\s[0]\i[6]I'll keep you company, but remember that getting enough rest is important.\e"
				"\0\s[2]Isn't it a little late?\e"
			}
		}elseif takagiwatch == 1{
			"\0\s[12]Wow...\w8\w8This is very interesting\w4\i[3]\e"
			"\0\s[12]Wow...\w8\w8This is getting interesting\w4\i[3]\e"
			"\0\s[12]\i[2]Hmmm...\e"
			"\0\s[12]I love music. What about you?\i[2]\e"
			"\0\s[12]Excellent soundtrack\w4\i[3]\e"
		}elseif takagiwatch == 2{
			//"\0\s[4]\i[0]\w8\w8\w8\b4Interesting...\e"
			//"\0\s[4]\i[0]\w8\w8\w8\b4...\e"
		}
	}
}


//--Chains
//Each chain function will go through each part of the chain in order even if it's in one function, until it goes to \e:chain=end which will end the chain, as you could probably guess. So you can put the entire chain dialogue into one place.

// achain
// {{CHAIN
// 	"\0\s[5]Desde entonces, no ha dejado de intentarlo jaja\e"
	
// 	"\0\s[8]A veces me pregunto qué es lo que realmente lo motiva.\e"
	
// 	"\0\s[5]Quizás no sea solo el deseo de vencerme,\nsino algo más...\e:chain=end"
// }}CHAIN

//Note also it ends with \e:chain=end, basically ending the chain.


//-OnMinuteChange
//These are time-related bits of dialogue for your ghost to say. If any of them look interesting, uncomment them! I commented them out for simplicity's sake, but it's up to you if you want to use them or not!

//OnMinuteChange
//{
