//--OpenSakuraMenu

OpenSakuraMenu
{
	if language=="ES"{
		if takagiwatch == 0{
			"\0\s[0]\b2¿Qué haremos ahora?."
		}elseif takagiwatch == 1{
			"\0\s[13]\b2Sí ¿Qué pasa?."
			"\0\s[13]\b2Sí, dime."
		}else{
			"\0\s[5]\b2Dime."
		}
	}else{
		if takagiwatch == 0{
			"\0\s[0]\b2What should we do now?"
		}elseif takagiwatch == 1{
			"\0\s[13]\b2Yes?\nWhat's wrong?"
			"\0\s[13]\b2Yes?\nI'm listening."
		}else{
			"\0\s[5]\b2What is it?"
		}
	}
	--
	MenuRun
}

//--MenuRun
//As you just saw above. This actually fills out the rest of the menu.

MenuRun : all
 {	
 	wd = GetWeekDay
 	ap = GetAP
	//It's putting together the information to display the time at the bottom of the balloon.
	--
	"\n\n\_q\b2" // \_q means quick session, meaning all the text from this point on will display instantly instead of a few letters at a time like normal ghost dialogue.
	--
	if language=="ES"{
		"\f[bold,1]Funciones\f[bold,0]\n\n[half]"
		if lastTalk != "" //What this does is check to see if the ghost has already said a random bit of dialogue on its own, essentially by seeing if the lastTalk thing is NOT empty (!= means "does not equal").
		{
		  "\![*]\q[Repite el último comentario,OnLastTalk]\n\n[half]"
		}
		--
	 	"\![*]\q[Dime algo,OnAiTalk]\n"
		"\![*]\q[Resumen,summary]\n"
		"\![*]\q[Especial,myspecial]\n"
		"\![*]\q[Lista de Pendientes,OnToDoList]\n\n"
		"\f[bold,1]Sistema\f[bold,0]\n\n[half]"
		"\![*]\q[Utilidades,dosomething]\n"
		"\![*]\q[Perfil,configmenu]\n"
		"\![*]\q[Créditos,informationCredits]\n\n"
	 	"\![*]\q[Salir,CANCEL]\n\n\n[half]%(wd), %(day)/%(month)/%(year) %(nowhour):%(nowmin)%(ap)\e"
	}else{
		"\f[bold,1]Features\f[bold,0]\n\n[half]"
		if lastTalk != ""
		{
		  "\![*]\q[Repeat the Last Comment,OnLastTalk]\n\n[half]"
		}
		--
		"\![*]\q[Tell Me Something,OnAiTalk]\n"
		"\![*]\q[Summary,summary]\n"
		"\![*]\q[Special,myspecial]\n"
		"\![*]\q[To-Do List,OnToDoList]\n\n"
		"\f[bold,1]System\f[bold,0]\n\n[half]"
		"\![*]\q[Utilities,dosomething]\n"
		"\![*]\q[Profile,configmenu]\n"
		"\![*]\q[Credits,informationCredits]\n\n"
		"\![*]\q[Exit,CANCEL]\n\n\n[half]%(wd), %(month)/%(day)/%(year) %(nowhour):%(nowmin)%(ap)\e"
	}
	
}

//Leave this alone
OnLastTalk 
{
"%(lastTalk)\e"
}

//This is figuring out what day of the week it is. Leave it alone.
GetWeekDay
{
	if language=="ES"{
		if weekday == 0
		{"Domingo"}
		elseif weekday == 1
		{"Lunes"}
		elseif weekday == 2
		{"Martes"}
		elseif weekday == 3
		{"Miercoles"}
		elseif weekday == 4
		{"Jueves"}
		elseif weekday == 5
		{"Viernes"}
		else
		{"Sabado"}
	}else{
		if weekday == 0
		{"Sunday"}
		elseif weekday == 1
		{"Monday"}
		elseif weekday == 2
		{"Tuesday"}
		elseif weekday == 3
		{"Wednesday"}
		elseif weekday == 4
		{"Thursday"}
		elseif weekday == 5
		{"Friday"}
		else
		{"Saturday"}
	}
}

//This is finding out whether it's AM or PM. Leave it alone.
GetAP
{
 	if hour >= 0 && hour <= 11
 		{"AM"}
 	else
 		{"PM"}
}

nowhour
{
	if hour12 == 0; "1"
	else; "%(hour12)"
}

nowmin
{
	if minute >= 0 && minute <=9; "0%(minute)"
	else; "%(minute)"
}


//If someone selects an option linked to BACKTOMENU, it will go back to MenuRun.

Select.BACKTOMENU
{
	MenuRun
}

//If someone selects configmenu, this will lead to TalkConfig.
Select.configmenu
{
	TalkConfig
}

//summary
Select.summary : all{
	"\0\b[2]"
	if language=="ES"{
		"\0\_q\f[align,center]\f[bold,1]Resumen\_q\n\n\f[align,left]\f[bold,0]"
		"\0\s[22]Deacuerdo, veamos que tenemos aquí.\n\n"

		_arrayMonthPrint="Enero,Febrero,Marzo,Abril,Mayo,Junio,Julio,Agosto,Septiembre,Octubre,Noviembre,Diciembre"
		"\0Hoy es \f[bold,1]%(wd) %(day) de %(_arrayMonthPrint[month-1]) del %(year)\f[bold,0]\n\n"

		_unfinishedTasks=ASEARCHEX(0,toDoArrayDone)
		_currentAny=ANY(_unfinishedTasks)
	
		if ARRAYSIZE(_unfinishedTasks)==1{
			"\0Tienes solo una tarea pendiente, %(toDoArray[_currentAny]), no la olvides.\n\n"
		}elseif ARRAYSIZE(_unfinishedTasks)>1{
			"\0Tienes un total de \f[bold,1]%(ARRAYSIZE(_unfinishedTasks)) tareas sin finalizar\f[bold,0], incluyendo %(toDoArray[_currentAny]), no la olvides.\n\n"
		}else{
			"\0No tienes tareas pendientes.\n\n"
		}
	
		if glicoRounds>0{
			"\0Hemos jugado un total de %(glicoRounds) veces piedra, papel o tijeras.\n\n"
		}else{
			"\0Nunca hemos jugado piedra, papel o tijeras, deberíamos intentarlo\n\n"
		}
	
		"\0Creo que eso sería todo por el momento.\e"
	}else{
		"\0\_q\f[align,center]\f[bold,1]Summary\_q\n\n\f[align,left]\f[bold,0]"
		"\0\s[22]Ok, here we go.\n\n"

		_arrayMonthPrint="January,February,March,April,May,June,July,August,September,October,November,December"
		"\0Today is \f[bold,1]%(wd), %(_arrayMonthPrint[month-1]) %(day), %(year)\f[bold,0]\n\n"

		_unfinishedTasks=ASEARCHEX(0,toDoArrayDone)
		_currentAny=ANY(_unfinishedTasks)
		
		if ARRAYSIZE(_unfinishedTasks)==1{
			"\0You only have one task pending: %(toDoArray[_currentAny]). Don't forget about it.\n\n"
		}elseif ARRAYSIZE(_unfinishedTasks)>1{
			"\0You have a total of \f[bold,1]%(ARRAYSIZE(_unfinishedTasks)) unfinished tasks\f[bold,0], including %(toDoArray[_currentAny]). Don't forget about it.\n\n"
		}else{
			"\0You don't have any pending tasks.\n\n"
		}
		
		if glicoRounds>0{
			"\0We've played rock, paper, scissors a total of %(glicoRounds) times.\n\n"
		}else{
			"\0We've never played rock, paper, scissors. We should give it a try.\n\n"
		}
		
		"\0I think that should be all for now.\e"
	}
}

