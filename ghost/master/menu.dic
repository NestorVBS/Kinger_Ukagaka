	}else{
		"\0\s[0]Hmm...\w6 It would be nice to watch episode %(_chapNumber) again.\s[0]\i[8]\n\n"
		"\0\s[0]Hmm...\w6 I feel like watching episode %(_chapNumber).\s[0]\i[8]\n\n"
	}
	
}  



