//This next set of functions handles inputting the user's birthday. If you don't want this to be a feature, you can ignore all of this. I marked where the birthday code starts and ends for you with some good old-fashioned ascii banners. :3

Select.TEACHBDAY
	{	
		if language=="ES"{
			"\0\s[0]En que mes naciste? \w8\s[0]\i[8]Nombre o número esta bien.\![open,inputbox,OnUserBornMonth,-1]\e"
		}else{
			"\0\s[0]What month were you born in? \w8\s[0]\i[8]The month's name or number is fine.\![open,inputbox,OnUserBornMonth,-1]\e"
		}
		
		//*********************Advanced User Info*******************************
		//I'm going to break down the tag there at the end of the sentence so you know what it's doing. Basically, \! means a function is going to happen, open tells it to open something, inputbox tells it to open an input box, and OnUserBornMonth is the function the input box will be linked to, which is just below here. -1 means the input box should not time out. If you want to add input boxes to some new function for whatever reason, you should follow this basic format.
		//On a related note, you can raise any function at the end of any piece of dialogue by using this format - \![raise,InsertFunctionName]. This can be handy for testing things if the function is hard to get to run otherwise.
		//***********************************************************************
	}

//--OnUserBornMonth
//This takes the value that the user put into the input box above and evaluates it.

OnUserBornMonth
{
	_tempmonth = TOSTR(reference0) //this stores what the user put in as a variable called _tempmonth
	_tempmonth = TOLOWER(_tempmonth) //changes it to lowercase
	
	//this is attaching the right value to the input from the user
	if _tempmonth == "january" || _tempmonth == "enero" || _tempmonth == "1" {bornmonth = 1; bornmonthprint = "Enero"; bornmonthprintEN = "January"}
	elseif _tempmonth == "february" || _tempmonth == "febrero" || _tempmonth == "2" {bornmonth = 2; bornmonthprint = "Febrero"; bornmonthprintEN = "February"}
	elseif _tempmonth == "march" || _tempmonth == "marzo" || _tempmonth == "3" {bornmonth = 3; bornmonthprint = "Marzo"; bornmonthprintEN = "March"}
	elseif _tempmonth == "april" || _tempmonth == "abril" || _tempmonth == "4" {bornmonth = 4; bornmonthprint = "Abril"; bornmonthprintEN = "April"}
	elseif _tempmonth == "may" || _tempmonth == "mayo" || _tempmonth == "5" {bornmonth = 5; bornmonthprint = "Mayo"; bornmonthprintEN = "May"}
	elseif _tempmonth == "june" || _tempmonth == "junio" || _tempmonth == "6" {bornmonth = 6; bornmonthprint = "Junio"; bornmonthprintEN = "June"}
	elseif _tempmonth == "july" || _tempmonth == "julio" || _tempmonth == "7" {bornmonth = 7; bornmonthprint = "Julio"; bornmonthprintEN = "July"}
	elseif _tempmonth == "august" || _tempmonth == "agosto" || _tempmonth == "8" {bornmonth = 8; bornmonthprint = "Agosto"; bornmonthprintEN = "August"}
	elseif _tempmonth == "september" || _tempmonth == "septiembre" || _tempmonth == "9" {bornmonth = 9; bornmonthprint = "Septiembre"; bornmonthprintEN = "September"}
	elseif _tempmonth == "october" || _tempmonth == "octubre" || _tempmonth == "10" {bornmonth = 10; bornmonthprint = "Octubre"; bornmonthprintEN = "October"}
	elseif _tempmonth == "november" || _tempmonth == "noviembre" || _tempmonth == "11" {bornmonth = 11; bornmonthprint = "Noviembre"; bornmonthprintEN = "November"}
	elseif _tempmonth == "december" || _tempmonth == "diiembre" || _tempmonth == "12" {bornmonth = 12; bornmonthprint = "Diciembre"; bornmonthprintEN = "December"}
	
	else //if the month isn't a valid month, like 32 or something.
	{
			if language=="ES"{
				"\0\s[0]Mmm... \w8\s[24]No creo haber oído hablar de ese mes. Inténtalo de nuevo."
			}else{
				"\0\s[0]Hmm... \w8\s[24]I don't think that's a month I've heard of. Try again."
			}
			--
			"\![open,inputbox,OnUserBornMonth,-1]\![set,balloontimeout,-1]\e"
	}
	--
	//If it's a valid month
	if language=="ES"{
		"\0\s[0]Así que naciste en %(bornmonthprint).\n\w8En que día?"
	}else{
		"\0\s[0]So, you were born in %(bornmonthprintEN).\n\w8What day were you born on?"
	}
	
	--
	"\![open,inputbox,OnUserBornDay,-1]\![set,balloontimeout,-1]\e"
}

//Los sufijos solo son necesarios en inglés en este caso, así que en caso de ocuparlo descomentar Printday

Printday
{
	if bornday == 1 || bornday == 21 || bornday == 31
	{	"%(bornday)st"	}
	elseif bornday == 2 || bornday == 22
	{	"%(bornday)nd"	}
	elseif bornday == 3 || bornday == 23
	{	"%(bornday)rd"	}
	else
	{	"%(bornday)th"	}
}	

//--OnUserBornDay
//This is much like the above function OnUserBornMonth. It'll take the value the user put in for the day and analyze it.

OnUserBornDay
{
	_tempday = reference0 //storing the input in _tempday
	_tempday = TOLOWER(_tempday) //changes it to lowercase
	_tempday = REPLACE(_tempday,"st","") //if the user types something like 2nd, 3rd, etc, this will make it just the number. It'll just add the suffix back later on the one that actually shows.
	_tempday = REPLACE(_tempday,"nd","")
	_tempday = REPLACE(_tempday,"rd","")
	_tempday = REPLACE(_tempday,"th","")
	_tempday = TOINT(_tempday) //Converts it to an integer
	
	if ((bornmonth == 1 || bornmonth == 3 || bornmonth == 5 || bornmonth == 7 || bornmonth == 8 || bornmonth == 10 || bornmonth == 12) && _tempday >= 1 && _tempday <= 31) || (bornmonth == 2 && _tempday >= 1 && _tempday <= 29) || ((bornmonth == 4 || bornmonth == 6 || bornmonth == 9 || bornmonth == 11) && _tempday >= 1 && _tempday <= 30) //This ugly function checks if the day falls into a valid range. If it does, we set some variables and continue down.
	{
		bornday = _tempday
		borndayprint=bornday//Cambiar por Printday si se usará en inglés
		borndayprintEN=Printday
		userbirthday = "%(bornmonth)month %(bornday)day"
		birthdayprintEN = "%(bornmonthprintEN) %(borndayprintEN)"
		birthdayprint = "%(borndayprint) de %(bornmonthprint)"
		
		"%(birthchecked)"
	}
	else
	{	
		if language=="ES"{
			"\0\s[2]Creo que ese día no es real. intentalo de nuevo."
		}else{
			"\0\s[2]Hmm... I don't think that's a real day. Try again."
		}
		--
		"\![open,inputbox,OnUserBornDay,-1]\e"
	}	
}

//--birthchecked

birthchecked
{
	if userbirthday == dayslot //if today is the user's birthday
	{
		if language=="ES"{"\0\s[7]¡¿Qué?!\n\n\w8\s[6]¡¿Hoy es tu cumpleaños?!\w8\n\n\w8\s[20]¡Feliz cumpleaños, %(username)!.\e"}else{"\0\s[7]What?!\n\n\w8\s[6]It's your birthday today?!\w8\n\n\w8\s[20]Happy Birthday, %(username)!"}
	}
	else //if the birthday is not listed above.
	{
		if language=="ES"{"\0\s[0]Así que tu cumpleaños es el %(borndayprint) de %(bornmonthprint). Lo recordaré.\e"}else{"\0\s[0]So, your birthday is on %(bornmonthprintEN) %(borndayprintEN). I'll remember that.\e"}
	}
}



