//--Talk Rate
//This is when the user chooses to adjust the talk rate in the config menu. The talk rate is how often the ghost will read some dialogue from aitalk.dic.


Select.talkinter : all
 {
 	if language=="ES"{
		"\0\s[0]\_q\b2¿Qué tan seguido debe hablar Kinger? El intervalo actual es cada %(talktime)."

		"\0\n\n[half]"
		"\![*]\q[Cada 30 segundos,TALKMAX]\n"
		"\![*]\q[Cada minuto,TALKHIGH]\n"
		"\![*]\q[Cada 3 minutos,TALKNORMAL]\n"
		"\![*]\q[Cada 5 minutos,TALKPOOR]\n"
		"\![*]\q[No hables,TALKNONE]\n\n[half]"
		"\![*]\q[Así esta bien,TalksTill]\e"
 	}else{
 		"\0\s[0]\_q\b2How often should Kinger speak? The current interval is every %(talktimeEN)."

		"\0\n\n[half]"
		"\![*]\q[Every 30 seconds,TALKMAX]\n"
		"\![*]\q[Every minute,TALKHIGH]\n"
		"\![*]\q[Every 3 minutes,TALKNORMAL]\n"
		"\![*]\q[Every 5 minutes,TALKPOOR]\n"
		"\![*]\q[Don't speak,TALKNONE]\n\n[half]"
		"\![*]\q[This is fine,TalksTill]\e"
 	}
}


Select.TalksTill
{
	if language=="ES"{
		"\0\s[23]Sin cambios, \i[1]esta perfecto entonces.\e"
	}else{
		"\0\s[23]No changes, then. \i[1]I think it's perfect just the way it is.\e"
	}	
}

//If the user chooses every 30 seconds.
Select.TALKMAX
	{
 		talktime = "30 segundos" //this sets up the envelope properly
 		talktimeEN = "30 seconds"
		aitalkinterval = 30 //this changes the actual rate
		
 		if language=="ES"{"\0\s[23]\i[1]Maravilloso, tengo muchas historias que contar.\s[24]\e"}else{"\0\s[23]\i[1]Wonderful! I've got so many stories to tell.\s[24]\e"}
	}

//If the user chooses every minute.
Select.TALKHIGH
	{
 		talktime = "minuto"
 		talktimeEN="Every minute"
		aitalkinterval = 60
		
 		if language=="ES"{"\0\s[23]Un minuto está bien.\nEs tiempo suficiente para asegurarme de que el mundo sigue aquí.\s[24]\e"}else{"\0\s[23]Un minuto está bien.\nEs tiempo suficiente para asegurarme de que el mundo sigue aquí.\s[24]\e"}
	}

//If the user chooses every three minutes.
Select.TALKNORMAL
	{
 		talktime = "3 minutos"
 		talktimeEN="3 minutes"
		aitalkinterval = 180
		
 		if language=="ES"{"\0\s[23]Tres minutos...\w8 \s[23]\i[1]Suena como un buen equilibrio.\nNo demasiado silencio... pero tampoco demasiado ruido.\e"}else{"\0\s[23]Three minutes...\w8 \s[23]\i[1]That sounds like a good balance.\nNot too much silence... but not too much noise either.\e"}
	}

//If the user chooses every five minutes. This is the default rate the ghost will start up in, as seen in bootend.dic.
Select.TALKPOOR
	{
 		talktime = "5 minutos"
 		talktimeEN="5 minutes"
		aitalkinterval = 300
		
 		if language=="ES"{"\0\s[0]Cinco minutos.\nEspero no distraerme y aparecer en otra habitación.\s[24]\e"}else{"\0\s[0]Five minutes.\nHopefully I won't get distracted and end up in another room.\s[24]\e"}
	}

//If the user chooses to not have them speak.
Select.TALKNONE
	{
 		talktime = "...En realidad no hablamos"
 		talktimeEN="...I think we don't talk"
		aitalkinterval = 0
		
		if language=="ES"{"\0\s[6]¿Silencio absoluto?\n\w8...\w8 Bueno.\nSi empiezo a mirar fijamente la pared, procura despertarme, ¿sí?\e"}else{"\0\s[6]Complete silence?\n\w8...\w8 Alright.\nIf I start staring at the wall, make sure you snap me out of it, okay?\e"}
	}



//This is when the user chooses to change their name. It's linked to the functions outlined in nameteach.dic.
Select.TEACHNAME
{
	OnTeachName	
}


