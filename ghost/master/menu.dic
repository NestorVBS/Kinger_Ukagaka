//If the user chooses to empty the recycle bin.

Select.ChoiceGarbagecan
{
	_gomicheck = FUNCTIONEX("gomi.dll", "-n")	//Don't touch this line. for those curious, it's referencing a SAORI, which are optional user-made plug-in dlls you can download to enable different functions on your ghost.
	
	if language=="ES"{
		if _gomicheck == 0 //If the recycle bin is empty.
		{
			"\0\s[0]Hora de sacar la basura, ya vuelvo.\w8\s[0]...\w8\w8\s[-1]\w8\w8\w8\w8\w8\s[0]\c\s[2]Estaba vacia.\e"
		}
		elseif _gomicheck >= 1 //If the recycle bin is full.
		{
			"\0\s[0]Vaciando la papelera.\w8\w8\s[-1]\w8\w8\w8\w8\w8\![raise,OnGarbagecanEmpty]\w9\w9\w9\s[0]\cListo.\e"
			
			"\0\s[0]Hora de sacar la basura, ya vuelvo.\w8\w8\s[-1]\w8\w8\w8\w8\w8\![raise,OnGarbagecanEmpty]\w9\w9\w9\s[0]\cHecho.\e"
			
			//Somewhat similar to the above, but notice the \![raise],OnGarbagecanEmpty] tag in there. That's what actually empties the recycle bin, so make sure you don't delete that tag.
		}
	}else{
		if _gomicheck == 0 //If the recycle bin is empty.
		{
			"\0\s[0]Time to take out the trash, I'll be right back.\w8\s[0]...\w8\w8\s[-1]\w8\w8\w8\w8\w8\s[0]\c\s[2]It was empty.\e"
		}
		elseif _gomicheck >= 1 //If the recycle bin is full.
		{
			"\0\s[0]Emptying the recycle bin.\w8\w8\s[-1]\w8\w8\w8\w8\w8\![raise,OnGarbagecanEmpty]\w9\w9\w9\s[20]\cDone.\e"
			
			"\0\s[0]Time to take out the trash, I'll be right back.\w8\w8\s[-1]\w8\w8\w8\w8\w8\![raise,OnGarbagecanEmpty]\w9\w9\w9\s[20]\cDone.\e"
			
			//Somewhat similar to the above, but notice the \![raise],OnGarbagecanEmpty] tag in there. That's what actually empties the recycle bin, so make sure you don't delete that tag.
		}
	}
}


//This is for the SAORI, don't touch it.
OnGarbagecanEmpty
{
	_gomi = FUNCTIONEX("gomi.dll", "-f")
}

//This is when the user chooses System Information. Don't touch any of this either. For those curious though, note that this is done using another SAORI, this time saori_cpuid.dll.
Select.ChoiceSystemInformation
{
	os_name = FUNCTIONEX("saori_cpuid.dll","os.name")
	os_version = FUNCTIONEX("saori_cpuid.dll","os.version")
	cpu_name = FUNCTIONEX("saori_cpuid.dll","cpu.name")
	cpu_clockex = FUNCTIONEX("saori_cpuid.dll","cpu.clockex")
	"/
	\0\s[0]\b[2]/
	\_q\f[bold,1]OS:\f[bold,0] %(os_name) %(os_version)\n/
	\f[bold,1]Memory Load:\f[bold,0] %(memoryload)%\n/
	\f[bold,1]Physical Memory:\f[bold,0] %(memoryavailphys) KB\n/
	\f[bold,1]CPU:\f[bold,0] %(cpu_name) %(cpu_clockex)MHz\n/
	\f[bold,1]Ukagaka:\f[bold,0] %property[baseware.version]/
	\e"
}

//si la seleccion es myspecial
Select.myspecial : all
{
	if language=="ES"{
		"\0\b2¿Qué haremos?\n\n"	
		--
		if takagiwatch == 0
		{
			"\![*]\q[Ir al escondite,study]\n"
			"\![*]\q[Veamos algo juntos,lookscreen]\n"
		}
		else
		{
			if takagiwatch==1{"\![*]\q[La función terminó,lookscreen]\n\n"}else{"\![*]\q[Sal de ahí,study]\n\n"}
		}
		//"\![*]\q[Veintiuno,TwentyOne]\n"
		"\![*]\q[Piedra papel o tijera,glico]\n"
		"\![*]\q[Recomienda un capitulo de TADC,animechap]\n\n"
		"\![*]\q[Volver Al Menú,BACKTOMENU]\e"
	}else{
		"\0\b2What shall we do?\n\n"
		
		if takagiwatch == 0
		{
			"\![*]\q[Go to the hideout,study]\n"
			"\![*]\q[Let's watch something together,lookscreen]\n"
		}
		else
		{
			if takagiwatch==1{"\![*]\q[The show is over,lookscreen]\n\n"}else{"\![*]\q[Get out of there,study]\n\n"}
		}
		//"\![*]\q[Twenty-One,TwentyOne]\n"*
		"\![*]\q[Rock Paper Scissors,glico]\n"
		"\![*]\q[Recommend a TADC episode,animechap]\n\n"
		"\![*]\q[Back to Menu,BACKTOMENU]\e"
	}
}


Select.lookscreen
{
	if language=="ES"{
		if takagiwatch == 0
		{	
			takagiwatch = 1
			"\0\s[13]Adoro el cine independiente.\w8\w8\w8\s[12]\e"
			"\0\s[13]Me encantan las de ciencia ficción.\w8\w8\w8\s[12]\e"
			"\0\s[13]¿Existiran perlículas de ajedrez?\w8\w8\w8\s[12]\e"
			"\0\s[13]¿Será algo acerca de insectos?\w8\w8\w8\s[12]\e"
		}
		else
		{
			takagiwatch = 0
			"\0\s[0]Fue divertido\i[6]\e"
		}
	}else{
		if takagiwatch == 0
		{	
			takagiwatch = 1
			"\0\s[13]I love independent movies.\w8\w8\w8\s[12]\e"
			"\0\s[13]I love science fiction movies.\w8\w8\w8\s[12]\e"
			"\0\s[13]I wonder if there are any chess movies.\w8\w8\w8\s[12]\e"
			"\0\s[13]I wonder if there are any movies about insects.\w8\w8\w8\s[12]\e"
		}
		else
		{
			takagiwatch = 0
			"\0\s[0]That was fun.\i[6]\e"
		}
	}
}

Select.study{
	if language=="ES"{
		if takagiwatch == 0
		{	
			takagiwatch = 2
			studyTime = 0
			
			"\0\s[5]Este lugar siempre me reconforta.\w8\s[4]\i[0]\e"
			"\0\s[5]Jeje esta oscuro...\w8\s[4]\i[0] Como me gusta\e"
		}
		else
		{
			_totalStudyTime = TOINT(studyTime/60)
			_fue = "fueron"
			_plural = "s"
			if _totalStudyTime==1{
				_fue="fue"
				_plural=""
			}
			studyTime=0
			takagiwatch=0
		
			"\0\s[0]¡Fua!\w8\w8\s[0] Hora de una nueva aventura?.\n\nSiento como si hubiera estado una eternidad ahí\s[2] pero apenas %(_fue) %(_totalStudyTime) minuto%(_plural).\n\nEl tiempo es relativo supongo.\w8\w8\w8\w8\w8\w8\s[0]\e"
		}
	}else{
		if takagiwatch == 0
		{
			takagiwatch = 2
			studyTime = 0
			
			"\0\s[5]This place always makes me feel better.\w8\s[4]\i[0]\e"
			"\0\s[5]Hehe, it's dark...\w8\s[4]\i[0] Just the way I like it.\e"
		}
		else
		{
			_totalStudyTime = TOINT(studyTime/60)
			_plural = "s"
			if _totalStudyTime==1{
				_plural=""
			}
			studyTime=0
			takagiwatch=0
			
			"\0\s[0]Whoa!\w8\w8\s[0] Time for a new adventure?\n\nIt feels like I've been in there for an eternity,\s[2] but it was only %(_totalStudyTime) minute%(_plural).\n\nI suppose time is relative.\w8\w8\w8\w8\w8\w8\s[0]\e"
		}
	}
}

OnToDoList:all
{
	if language=="ES"{
		"\0\s[22]\b2\_q\f[bold,1]\f[align,center]Tareas Pendientes\s[22]\i[1]\n\n\n[half]\f[bold,0]\f[align,left]"

		_size = ARRAYSIZE(toDoArray)
		if _size>0{
			for _i=0;_i<_size;_i++
			{
				if toDoArrayDone[_i]==1{
					"\q[✅ ,OnTasks,done,%(_i)]\f[strike,1]%(toDoArray[_i])\f[strike,0]"
				}else{
					"\q[🔲 ,OnTasks,done,%(_i)]%(toDoArray[_i])"
				}
				"\f[sup,1]\q[  Borrar,OnTasks,delete,%(_i)]\f[sup,0]\n\n[half]"
			}
		}else{
			"No tienes tareas pendientes\n\n[half]"
		}

		"\n\![*]\q[Agregar Tarea✏️,addToDo]"
		if _size>0{"\n\![*]\q[Borrar todo🗑️,OnTasks,deleteAll]"}
		"\n\n\![*]\q[Volver Al Menú,BACKTOMENU]"
		"\n\![*]\q[Salir,CANCEL]\e"
	}else{
		"\0\s[22]\b2\_q\f[bold,1]\f[align,center]To-Do List\s[22]\i[1]\n\n\n[half]\f[bold,0]\f[align,left]"
		
		_size = ARRAYSIZE(toDoArray)
		if _size>0{
			for _i=0;_i<_size;_i++
			{
				if toDoArrayDone[_i]==1{
					"\q[✅ ,OnTasks,done,%(_i)]\f[strike,1]%(toDoArray[_i])\f[strike,0]"
				}else{
					"\q[🔲 ,OnTasks,done,%(_i)]%(toDoArray[_i])"
				}
				"\f[sup,1]\q[  Delete,OnTasks,delete,%(_i)]\f[sup,0]\n\n[half]"
			}
		}else{
			"No pending tasks\n\n[half]"
		}
		
		"\n\![*]\q[Add Task✏️,addToDo]"
		if _size>0{"\n\![*]\q[Delete All🗑️,OnTasks,deleteAll]"}
		"\n\n\![*]\q[Back to Menu,BACKTOMENU]"
		"\n\![*]\q[Exit,CANCEL]\e"
	}
}

Select.addToDo{
	if language=="ES"{"\_q¿Qué tarea deseas añadir?"}else{"\_qWhat task would you like to add?"}
	--
	"\![open,inputbox,OnTasks,-1]\![enter,passivemode]"
}

OnTasks:all{
	if reference0=="done"{
		if toDoArrayDone[reference1]==0{
			toDoArrayDone[reference1]=1
		}else{
			toDoArrayDone[reference1]=0
		}
	}elseif reference0=="delete"{
		toDoArray[reference1] = IARRAY
		toDoArrayDone[reference1] = IARRAY
	}elseif reference0=="deleteAll"{
		if language=="ES"{
			"\0\s[2]¿Estas seguro de que deseas borrar \f[bold,1]TODAS\f[bold,0] las tareas?\n\n"
			--
			"\_q\f[align,center]\f[bold,1]\_l[80,50]\![*]\q[SI,deleteAllToDo]\_l[150,50]\![*]\q[NO,OnToDoList]\n\f[align,left]\f[bold,0]\e"
		}else{
			"\0\s[2]Are you sure you want to delete \f[bold,1]ALL\f[bold,0] tasks?\n\n"
			--
			"\_q\f[align,center]\f[bold,1]\_l[80,50]\![*]\q[YES,deleteAllToDo]\_l[150,50]\![*]\q[NO,OnToDoList]\n\f[align,left]\f[bold,0]\e"
		}

	}else{
		"\![leave,passivemode]"
		toDoArray ,= reference0
		toDoArrayDone ,= 0
	}
	OnToDoList
}

Select.deleteAllToDo{
	toDoArray = IARRAY
	toDoArrayDone = IARRAY
	OnToDoList
}
