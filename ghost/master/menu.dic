//---- OnChoiceTimeout ---------------------------------------------------------
//If the user is given a menu with choices, but doesn't pick one of the choices, it will eventually time out. At that point, they will say this dialogue.

OnChoiceTimeout
 {
 	if language=="ES"{
		"\0Talvez luego.\w8\w8\w8\![raise,OnSurfaceRestore]\e"
		"\0Quizá más tarde.\w8\w8\w8\![raise,OnSurfaceRestore]\e"
		"\0¿Sigues ahí?\w8\w8\w8\![raise,OnSurfaceRestore]\e"
 	}else{
		"\0Maybe later.\w8\w8\w8\![raise,OnSurfaceRestore]\e"
		"\0Perhaps later.\w8\w8\w8\![raise,OnSurfaceRestore]\e"
		"\0Are you still there?\w8\w8\w8\![raise,OnSurfaceRestore]\e"
 	}
 }